# Copy to api/.env and fill in real values.

# ---- Model / server ----
HEMOSENSE_MODEL_PATH=../models/anfis.json
HEMOSENSE_MAX_UPLOAD_MB=10

# ---- Amazon Bedrock (primary; tried in order before OpenRouter; uses the AWS credential chain / EC2 instance role) ----
HEMOSENSE_BEDROCK_MODELS=deepseek.v3-v1:0,qwen.qwen3-235b-a22b-2507-v1:0,apac.amazon.nova-pro-v1:0
HEMOSENSE_BEDROCK_REGION=ap-south-1

# ---- OpenRouter (Dietary Intelligence fallback) ----
OPENROUTER_API_KEY=sk-or-v1-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
HEMOSENSE_LLM_MODELS=openrouter/free,google/gemma-4-31b-it:free,nvidia/nemotron-3-ultra-550b-a55b:free
HEMOSENSE_LLM_MAX_TOKENS=600
HEMOSENSE_LLM_TIMEOUT_SECONDS=60

# ---- CORS (comma-separated origins; "*" for dev) ----
HEMOSENSE_CORS_ORIGINS=*